datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccessTier {
  FREE
  PRO
  ENTERPRISE
}

enum LanguagePref {
  PT
  EN
}

model DossierLead {
  id               String     @id @default(uuid())
  name             String     @map("name")
  email            String     @unique @map("email")
  phone            String     @map("phone") // WhatsApp Number
  tierAccess       AccessTier @default(FREE) @map("tier_access")
  registrationDate DateTime   @default(now()) @map("registration_date")

  @@map("dossier_leads")
}

model SubscriberLead {
  id                 String       @id @default(uuid()) @map("id")
  fullName           String       @map("full_name")
  corporateEmail     String       @unique @map("corporate_email")
  whatsappNumber     String       @map("whatsapp_number")
  languagePreference LanguagePref @default(PT) @map("language_preference")
  planTier           AccessTier   @default(FREE) @map("plan_tier")
  registrationDate   DateTime     @default(now()) @map("registration_date")

  @@map("subscriber_leads")
}

model SpeakerApplication {
  id                     String   @id @default(uuid()) @map("id")
  fullName               String   @map("full_name")
  professionalTitle      String   @map("professional_title")
  companyName            String   @map("company_name")
  whatsappNumber         String   @map("whatsapp_number")
  emailAddress           String   @map("email_address")
  speakerTopic           String   @map("speaker_topic")
  observations           String?
  registrationCode       String?  @map("registration_code")
  attachmentVerification String   @map("attachment_verification")
  dataProtectionConsent  Boolean  @map("data_protection_consent")
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("speaker_applications")
}

model ParticipantApplication {
  id                    String   @id @default(uuid())
  fullName              String   @map("full_name")
  phoneNumber           String?  @map("phone_number")
  emailAddress          String   @map("email_address")
  companyName           String?  @map("company_name")
  registrationCode      String?  @map("registration_code")
  dataProtectionConsent Boolean  @map("data_protection_consent")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("participant_applications")
}

model PartnerApplication {
  id                    String   @id @default(uuid())
  companyName           String   @map("company_name")
  contactName           String   @map("contact_name")
  emailAddress          String   @map("email_address")
  phoneNumber           String?  @map("phone_number")
  objectives            String?  
  dataProtectionConsent Boolean  @map("data_protection_consent")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("partner_applications")
}
