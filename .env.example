# =========================================================================
# CONFIGURAÇÕES DO SERVER BACKEND (NODE.JS + PRISMA)
# =========================================================================

# Porta na qual o servidor Node.js backend irá correr
PORT=3001

# String de ligação para a base de dados PostgreSQL (utilizada pelo Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/digitalent_db?schema=public"

# =========================================================================
# CONFIGURAÇÕES DO FRONTEND (VITE / REACT) - DEVEM COMEÇAR COM VITE_
# =========================================================================

# URL pública oficial onde o frontend estará alojado (ex: https://digitalent.pt)
VITE_FRONTEND_URL="http://localhost:5173"

# URL de integração do gateway da API para envio silencioso via WhatsApp (ex: Z-API, Evolution API, etc.)
VITE_WHATSAPP_API_URL="https://api.gateway-whatsapp.com/v1"

# Token de autorização e autenticação do gateway da API de WhatsApp
VITE_WHATSAPP_API_TOKEN="seu_token_secreto_aqui"

# Número de telemóvel do administrador que receberá os comprovativos oficiais em PDF (com indicativo de país, ex: 351999999999)
VITE_ADMIN_WHATSAPP="351999999999"
